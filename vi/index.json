[{"content":"\u003cp\u003eXử lý exception giúp code ổn định và dễ debug.\u003c/p\u003e\n\u003ch2 id=\"ví-dụ\"\u003eVí dụ\u003c/h2\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-java\" data-lang=\"java\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003etry\u003c/span\u003e {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    \u003cspan style=\"color:#66d9ef\"\u003eint\u003c/span\u003e result \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e 10 \u003cspan style=\"color:#f92672\"\u003e/\u003c/span\u003e 0;\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e} \u003cspan style=\"color:#66d9ef\"\u003ecatch\u003c/span\u003e(ArithmeticException e) {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    System.\u003cspan style=\"color:#a6e22e\"\u003eout\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003eprintln\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#34;Cannot divide by zero!\u0026#34;\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e} \u003cspan style=\"color:#66d9ef\"\u003efinally\u003c/span\u003e {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    System.\u003cspan style=\"color:#a6e22e\"\u003eout\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003eprintln\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#34;Always executed\u0026#34;\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e}\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003ch3 id=\"mẹo\"\u003eMẹo\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eSử dụng \u003ccode\u003etry-with-resources\u003c/code\u003e cho AutoCloseable.\u003c/li\u003e\n\u003cli\u003eKhông catch generic \u003ccode\u003eException\u003c/code\u003e trừ khi thật sự cần.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Quản lý exception tốt giúp ứng dụng chạy ổn định và dễ bảo trì.\u003c/p\u003e\n","description":"Cách xử lý exception trong Java một cách hiệu quả.","image":"/images/blogs/java-exception.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/java-exception-handling-tips/","title":"Java Exception Handling Tips"},{"content":"\u003cp\u003eModules giúp tách code thành các file reusable.\u003c/p\u003e\n\u003ch2 id=\"ví-dụ\"\u003eVí dụ\u003c/h2\u003e\n\u003cp\u003e\u003ccode\u003emath.js\u003c/code\u003e\u003c/p\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-javascript\" data-lang=\"javascript\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003eexport\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003efunction\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003eadd\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003ea\u003c/span\u003e, \u003cspan style=\"color:#a6e22e\"\u003eb\u003c/span\u003e) { \u003cspan style=\"color:#66d9ef\"\u003ereturn\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003ea\u003c/span\u003e \u003cspan style=\"color:#f92672\"\u003e+\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003eb\u003c/span\u003e; }\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003eexport\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003efunction\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003esub\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003ea\u003c/span\u003e, \u003cspan style=\"color:#a6e22e\"\u003eb\u003c/span\u003e) { \u003cspan style=\"color:#66d9ef\"\u003ereturn\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003ea\u003c/span\u003e \u003cspan style=\"color:#f92672\"\u003e-\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003eb\u003c/span\u003e; }\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003cp\u003e\u003ccode\u003eapp.js\u003c/code\u003e\u003c/p\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-javascript\" data-lang=\"javascript\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003eimport\u003c/span\u003e { \u003cspan style=\"color:#a6e22e\"\u003eadd\u003c/span\u003e } \u003cspan style=\"color:#a6e22e\"\u003efrom\u003c/span\u003e \u003cspan style=\"color:#e6db74\"\u003e\u0026#39;./math.js\u0026#39;\u003c/span\u003e;\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003elog\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003eadd\u003c/span\u003e(\u003cspan style=\"color:#ae81ff\"\u003e2\u003c/span\u003e,\u003cspan style=\"color:#ae81ff\"\u003e3\u003c/span\u003e)); \u003cspan style=\"color:#75715e\"\u003e// 5\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Modules giúp tránh global scope pollution và tăng maintainability.\u003c/p\u003e\n","description":"Học cách tổ chức code bằng ES6 modules trong JavaScript.","image":"/images/blogs/js-module.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/javascript-modules-explained/","title":"JavaScript Modules Explained"},{"content":"\u003cp\u003eJava 8 trở đi hỗ trợ lập trình functional với lambda và streams.\u003c/p\u003e\n\u003ch2 id=\"ví-dụ\"\u003eVí dụ\u003c/h2\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-java\" data-lang=\"java\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003eList\u003cspan style=\"color:#f92672\"\u003e\u0026lt;\u003c/span\u003eInteger\u003cspan style=\"color:#f92672\"\u003e\u0026gt;\u003c/span\u003e numbers \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e Arrays.\u003cspan style=\"color:#a6e22e\"\u003easList\u003c/span\u003e(1, 2, 3, 4);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003enumbers.\u003cspan style=\"color:#a6e22e\"\u003estream\u003c/span\u003e()\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e       .\u003cspan style=\"color:#a6e22e\"\u003emap\u003c/span\u003e(n \u003cspan style=\"color:#f92672\"\u003e-\u0026gt;\u003c/span\u003e n \u003cspan style=\"color:#f92672\"\u003e*\u003c/span\u003e n)\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e       .\u003cspan style=\"color:#a6e22e\"\u003eforEach\u003c/span\u003e(System.\u003cspan style=\"color:#a6e22e\"\u003eout\u003c/span\u003e::println);\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003ch3 id=\"mẹo\"\u003eMẹo\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ccode\u003emap\u003c/code\u003e, \u003ccode\u003efilter\u003c/code\u003e, \u003ccode\u003ereduce\u003c/code\u003e là những function quan trọng.\u003c/li\u003e\n\u003cli\u003eGiúp code gọn, dễ test và maintain.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Functional programming trong Java giúp code modular và readable.\u003c/p\u003e\n","description":"Tận dụng lambda và streams để viết code theo phong cách functional trong Java.","image":"/images/blogs/java-functional.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/functional-programming-in-java/","title":"Functional Programming in Java"},{"content":"\u003cp\u003eEvent Loop là trái tim của JS runtime.\u003c/p\u003e\n\u003ch2 id=\"nguyên-lý-hoạt-động\"\u003eNguyên lý hoạt động\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eCall Stack\u003c/strong\u003e: Nơi lưu function đang chạy.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eMessage Queue\u003c/strong\u003e: Nơi lưu callback.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eEvent Loop\u003c/strong\u003e: Kiểm tra stack rỗng để xử lý queue.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-javascript\" data-lang=\"javascript\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003elog\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#39;Start\u0026#39;\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#a6e22e\"\u003esetTimeout\u003c/span\u003e(() =\u0026gt; \u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003elog\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#39;Timeout\u0026#39;\u003c/span\u003e), \u003cspan style=\"color:#ae81ff\"\u003e0\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003elog\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#39;End\u0026#39;\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003ch3 id=\"output\"\u003eOutput\u003c/h3\u003e\n\u003cpre tabindex=\"0\"\u003e\u003ccode\u003eStart\r\nEnd\r\nTimeout\n\u003c/code\u003e\u003c/pre\u003e\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Hiểu event loop giúp debug async code và promise chaining dễ dàng hơn.\u003c/p\u003e\n","description":"Hiểu rõ cơ chế event loop để xử lý async code trong JavaScript.","image":"/images/blogs/eventloop.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/javascript-event-loop-demystified/","title":"JavaScript Event Loop Demystified"},{"content":"\u003cp\u003eJava 17 mang đến nhiều cải tiến hữu ích.\u003c/p\u003e\n\u003ch2 id=\"nổi-bật\"\u003eNổi bật\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eSealed Classes\u003c/strong\u003e: Giới hạn class con.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eRecords\u003c/strong\u003e: Data class ngắn gọn.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePattern Matching for switch\u003c/strong\u003e: Dễ đọc hơn.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-java\" data-lang=\"java\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003erecord\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003ePoint\u003c/span\u003e(\u003cspan style=\"color:#66d9ef\"\u003eint\u003c/span\u003e x, \u003cspan style=\"color:#66d9ef\"\u003eint\u003c/span\u003e y) {}\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003ePoint p \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003enew\u003c/span\u003e Point(1, 2);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003eSystem.\u003cspan style=\"color:#a6e22e\"\u003eout\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003eprintln\u003c/span\u003e(p.\u003cspan style=\"color:#a6e22e\"\u003ex\u003c/span\u003e());\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Cập nhật lên Java 17 để tận dụng các tính năng hiện đại và tối ưu code.\u003c/p\u003e\n","description":"Những tính năng mới thú vị trong Java 17 bạn nên thử.","image":"/images/blogs/java17.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/java-17-features-you-must-know/","title":"Java 17 Features You Must Know"},{"content":"\u003cp\u003eAsync/Await giúp viết code bất đồng bộ trông như đồng bộ.\u003c/p\u003e\n\u003ch2 id=\"ví-dụ\"\u003eVí dụ\u003c/h2\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-javascript\" data-lang=\"javascript\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003easync\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003efunction\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003efetchData\u003c/span\u003e() {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e  \u003cspan style=\"color:#66d9ef\"\u003etry\u003c/span\u003e {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    \u003cspan style=\"color:#66d9ef\"\u003elet\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003eresponse\u003c/span\u003e \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003eawait\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003efetch\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#39;https://api.example.com/data\u0026#39;\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    \u003cspan style=\"color:#66d9ef\"\u003elet\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003edata\u003c/span\u003e \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003eawait\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003eresponse\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003ejson\u003c/span\u003e();\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    \u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003elog\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003edata\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e  } \u003cspan style=\"color:#66d9ef\"\u003ecatch\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003eerr\u003c/span\u003e) {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    \u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003eerror\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003eerr\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e  }\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e}\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#a6e22e\"\u003efetchData\u003c/span\u003e();\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003ch3 id=\"mẹo\"\u003eMẹo\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eLuôn dùng \u003ccode\u003etry/catch\u003c/code\u003e để xử lý lỗi.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003eawait\u003c/code\u003e chỉ dùng trong \u003ccode\u003easync\u003c/code\u003e function.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Async/await giúp tránh callback hell và code readable hơn.\u003c/p\u003e\n","description":"Học cách xử lý asynchronous code trong JavaScript dễ dàng với async/await.","image":"/images/blogs/js-async.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/async-await-in-javascript/","title":"Async/Await in JavaScript"},{"content":"\u003cp\u003eGenerics giúp code Java an toàn kiểu dữ liệu và dễ bảo trì.\u003c/p\u003e\n\u003ch2 id=\"vì-sao-cần-sử-dụng-generics\"\u003eVì sao cần sử dụng Generics?\u003c/h2\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-java\" data-lang=\"java\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003eList\u003cspan style=\"color:#f92672\"\u003e\u0026lt;\u003c/span\u003eString\u003cspan style=\"color:#f92672\"\u003e\u0026gt;\u003c/span\u003e names \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003enew\u003c/span\u003e ArrayList\u003cspan style=\"color:#f92672\"\u003e\u0026lt;\u0026gt;\u003c/span\u003e();\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003enames.\u003cspan style=\"color:#a6e22e\"\u003eadd\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#34;Alice\u0026#34;\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#75715e\"\u003e// names.add(10); // Lỗi biên dịch!\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003ch3 id=\"mẹo\"\u003eMẹo\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eSử dụng \u003ccode\u003e\u0026lt;T\u0026gt;\u003c/code\u003e cho class hoặc method.\u003c/li\u003e\n\u003cli\u003eGiúp tránh casting thủ công.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Generics tăng type-safety nhưng không thể sử dụng với primitive types trực tiếp.\u003c/p\u003e\n","description":"Tìm hiểu về generics và cách chúng giúp code an toàn hơn.","image":"/images/blogs/java-generic.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/java-generics-explained/","title":"Java Generics Explained"},{"content":"\u003cp\u003eClosures là một trong những khái niệm mạnh mẽ nhất trong JavaScript.\u003c/p\u003e\n\u003ch2 id=\"closure-là-gì\"\u003eClosure là gì?\u003c/h2\u003e\n\u003cp\u003eClosure là khi một function nhớ được scope bên ngoài nó ngay cả khi function đó được gọi ở nơi khác:\u003c/p\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-javascript\" data-lang=\"javascript\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003efunction\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003emakeCounter\u003c/span\u003e() {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e  \u003cspan style=\"color:#66d9ef\"\u003elet\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003ecount\u003c/span\u003e \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e \u003cspan style=\"color:#ae81ff\"\u003e0\u003c/span\u003e;\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e  \u003cspan style=\"color:#66d9ef\"\u003ereturn\u003c/span\u003e \u003cspan style=\"color:#66d9ef\"\u003efunction\u003c/span\u003e() {\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    \u003cspan style=\"color:#a6e22e\"\u003ecount\u003c/span\u003e\u003cspan style=\"color:#f92672\"\u003e++\u003c/span\u003e;\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e    \u003cspan style=\"color:#66d9ef\"\u003ereturn\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003ecount\u003c/span\u003e;\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e  }\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e}\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#66d9ef\"\u003econst\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003ecounter\u003c/span\u003e \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e \u003cspan style=\"color:#a6e22e\"\u003emakeCounter\u003c/span\u003e();\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003elog\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003ecounter\u003c/span\u003e()); \u003cspan style=\"color:#75715e\"\u003e// 1\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e\u003cspan style=\"color:#75715e\"\u003e\u003c/span\u003e\u003cspan style=\"color:#a6e22e\"\u003econsole\u003c/span\u003e.\u003cspan style=\"color:#a6e22e\"\u003elog\u003c/span\u003e(\u003cspan style=\"color:#a6e22e\"\u003ecounter\u003c/span\u003e()); \u003cspan style=\"color:#75715e\"\u003e// 2\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003ch3 id=\"mẹo\"\u003eMẹo\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003eDùng closures để tạo private variables.\u003c/li\u003e\n\u003cli\u003eTránh lạm dụng closures trong vòng lặp để prevent memory leaks.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Closures là chìa khóa để hiểu nhiều pattern trong JS như module hoặc callback.\u003c/p\u003e\n","description":"Khám phá sức mạnh của closures trong JavaScript.","image":"/images/blogs/js-closures.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/understanding-javascript-closures/","title":"Understanding JavaScript Closures"},{"content":"\u003cp\u003eJava Streams giúp bạn thao tác trên collections một cách dễ dàng và hiệu quả.\u003c/p\u003e\n\u003ch2 id=\"stream-basics\"\u003eStream Basics\u003c/h2\u003e\n\u003cp\u003eBạn có thể tạo Stream từ List, Set, hoặc Arrays:\u003c/p\u003e\n\u003cdiv class=\"highlight\"\u003e\u003cpre tabindex=\"0\" style=\"color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;\"\u003e\u003ccode class=\"language-java\" data-lang=\"java\"\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003eList\u003cspan style=\"color:#f92672\"\u003e\u0026lt;\u003c/span\u003eString\u003cspan style=\"color:#f92672\"\u003e\u0026gt;\u003c/span\u003e names \u003cspan style=\"color:#f92672\"\u003e=\u003c/span\u003e Arrays.\u003cspan style=\"color:#a6e22e\"\u003easList\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#34;Alice\u0026#34;\u003c/span\u003e, \u003cspan style=\"color:#e6db74\"\u003e\u0026#34;Bob\u0026#34;\u003c/span\u003e, \u003cspan style=\"color:#e6db74\"\u003e\u0026#34;Charlie\u0026#34;\u003c/span\u003e);\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003enames.\u003cspan style=\"color:#a6e22e\"\u003estream\u003c/span\u003e()\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e     .\u003cspan style=\"color:#a6e22e\"\u003efilter\u003c/span\u003e(name \u003cspan style=\"color:#f92672\"\u003e-\u0026gt;\u003c/span\u003e name.\u003cspan style=\"color:#a6e22e\"\u003estartsWith\u003c/span\u003e(\u003cspan style=\"color:#e6db74\"\u003e\u0026#34;A\u0026#34;\u003c/span\u003e))\n\u003c/span\u003e\u003c/span\u003e\u003cspan style=\"display:flex;\"\u003e\u003cspan\u003e     .\u003cspan style=\"color:#a6e22e\"\u003eforEach\u003c/span\u003e(System.\u003cspan style=\"color:#a6e22e\"\u003eout\u003c/span\u003e::println);\n\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\u003ch3 id=\"mẹo\"\u003eMẹo\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ccode\u003emap()\u003c/code\u003e để biến đổi dữ liệu.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003efilter()\u003c/code\u003e để lọc.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003ecollect()\u003c/code\u003e để gom kết quả lại.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c!-- raw HTML omitted --\u003e\n\u003cp\u003e\u003cstrong\u003eN.B.\u003c/strong\u003e Streams giúp viết code ngắn gọn, nhưng hãy nhớ lazy evaluation và tránh side-effect.\u003c/p\u003e\n","description":"Học cách sử dụng Java Streams để xử lý dữ liệu dễ dàng.","image":"/images/blogs/java-streams.png","permalink":"https://bangtrinh.github.io/my-blog/vi/blogs/java-streams-made-easy/","title":"Java Streams Made Easy"}]